# Environments
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Data & weights (tracked via docs/dataset_plan.md + configs, not git)
datasets/*
!datasets/README.md
!datasets/LICENSES.md
!datasets/splits/
weights/*
!weights/README.md

# Derived config copies (regenerated by training/icsd.py; gap 6 workaround)
training/generated/

# Experiment outputs
results/*
!results/README.md
experiments/*
!experiments/README.md

# OS
.DS_Store
csa_ppe_v1.zip

# Python bytecode and tool caches (also at any depth)
**/__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Dataset archives and large binaries (never commit; keep locally for Colab upload)
*.zip
*.tar
*.tar.gz

# Model weights and training run outputs (Ultralytics default run dir is runs/)
*.pt
*.pth
*.onnx
runs/
wandb/

# Logs and scratch
*.log
*.tmp

# Small audit records (JSON only) are versioned; bulky results stay ignored
!results/metrics_summary.json
!results/PRE_TRAINING_AUDIT.json
!results/dataset_audit.json
!results/dataset_audit_clean.json

# CSA-Vid: the provenance and licence log is versioned; the video clips are not
!datasets/csa_vid/
datasets/csa_vid/raw/
!datasets/csa_vid/SOURCES.md
!results/dataset_validation_clean.json
!results/dataset_validation_original.json
